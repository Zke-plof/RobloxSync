{
  "name": "roblox-sync",
  "displayName": "Roblox Sync",
  "description": "Real-time sync between Roblox Studio and VS Code",
  "version": "1.0.0",
  "publisher": "roblox-sync-dev",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "package": "vsce package --noVerify",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "18.x"
  },
  "dependencies": {
    "axios": "^1.6.0"
  }
}
